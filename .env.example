# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Chatbot Mode: "lead" or "normal"
CHATBOT_MODE=lead

# Firebase Firestore Configuration (Used ONLY for storing Leads, NO chat history stored)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: Path to Firebase Service Account JSON file instead of individual env vars
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Security: Secret API key required to access the GET /api/leads endpoint
LEADS_API_KEY=your_secure_random_leads_api_key_here

